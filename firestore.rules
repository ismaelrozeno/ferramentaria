rules_version = '2';

// Ninguém acessa o Firestore direto pelo navegador.
// Todo acesso passa pela API (firebase-admin ignora estas regras).
// Veja docs/decisoes.md, "Banco trocável", regra 1.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
